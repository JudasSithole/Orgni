{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@/components/ui/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/utils": ["./src/lib/utils.ts"]
    }
  }
}
