# Orgni Document Intelligence — environment (never commit a real .env).
# In Azure these are set as Container Apps environment variables / secrets.

# --- Server ---
PORT=8000

# --- Storage ---
# Must be writable. Containers should point this at a scratch dir; the service
# is otherwise stateless.
UPLOAD_DIR=/tmp/orgni-uploads

# --- Limits ---
MAX_FILE_SIZE_BYTES=20971520

# --- Optional LLM extraction ---
# Only used by the legacy /run integrity pipeline for fields regex could not
# find. The Phase 1 /v1/analyze path is rule-based and does not require a key.
# ANTHROPIC_API_KEY=
