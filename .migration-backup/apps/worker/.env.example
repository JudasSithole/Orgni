# Orgni worker — example environment (no secrets; copy to .env for local use)
NODE_ENV=development
# Polling interval for the job loop (ms)
WORKER_POLL_INTERVAL_MS=5000
# PostgreSQL connection string
# DATABASE_URL=postgres://user:password@localhost:5432/orgni
# Redis connection string (job queues)
# REDIS_URL=redis://localhost:6379
# GIT_SHA=
