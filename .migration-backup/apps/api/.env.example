# Orgni API — example environment (no secrets; copy to .env for local use)
# All values are validated at boot by @workspace/config (fails fast when invalid).

NODE_ENV=development
# Azure Container Apps does NOT inject PORT — set it and match the ingress targetPort.
PORT=8080

# --- CORS (production) ---
# Comma-separated allowed origins; wildcard subdomains supported.
# Unset in production = same-origin only. Ignored in development.
# CORS_ORIGINS=https://app.orgni.olyxee.com,https://*.vercel.app

# --- Logging ---
LOG_LEVEL=info

# --- Document pipeline services ---
# Python Document Intelligence (OCR/classification/extraction). Unset = upload 503s.
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
# Python Organizational Ontology (tokens → reviewable facts). Unset = tokens-only.
ONTOLOGY_URL=http://localhost:8100

# --- Persistence ---
# When set, sources/tokens/facts are stored and retrievable via GET /api/documents.
# Unset = results returned inline but not persisted.
DATABASE_URL=postgres://orgni:orgni@localhost:5432/orgni
# Max upload size in bytes (default 20 MB).
# MAX_UPLOAD_BYTES=20971520

# --- Release metadata (set by CI/CD, surfaced by GET /api/version) ---
# APP_VERSION=
# GIT_SHA=

# --- Future: Azure Blob Storage for uploads (API stays stateless) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
