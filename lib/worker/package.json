{
  "name": "@workspace/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./pipeline": "./src/pipeline.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
