    "@workspace/organizational-tokenizer": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "catalog:"
  }
}
