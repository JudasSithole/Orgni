{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./repository": "./src/repository.ts",
    "./connect": "./src/connect.ts"
  },
 "scripts": {
  "push": "drizzle-kit push --config ./drizzle.config.ts",
  "generate": "drizzle-kit generate --config ./drizzle.config.ts",
  "migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
  "typecheck": "tsc -p tsconfig.json --noEmit",
  "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "catalog:"
  }
}
